APP_NAME=CodeMate
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=false

HOST=127.0.0.1
PORT=8000

LOG_LEVEL=INFO
LOG_JSON_ENABLED=false
ACCESS_LOG_ENABLED=true

WORKSPACE_ROOT=.
WORKSPACE_MAX_FILE_BYTES=1000000
WORKSPACE_MAX_TREE_ENTRIES=5000

STORAGE_ENABLED=false
DATABASE_URL=sqlite+aiosqlite:///./codemate.db

MODEL_PROVIDER=mock
MODEL_BASE_URL=
MODEL_NAME=mock-model
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2

ENABLE_SENSITIVE_CONTENT_DETECTION=true
ENABLE_RATE_LIMIT=false
RATE_LIMIT_PER_MINUTE=60
