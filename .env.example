APP_NAME=CodeMate
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=false

HOST=127.0.0.1
PORT=8000

LOG_LEVEL=INFO
LOG_JSON_ENABLED=false
ACCESS_LOG_ENABLED=true

WORKSPACE_ROOT=.
WORKSPACE_MAX_FILE_BYTES=1000000
WORKSPACE_MAX_TREE_ENTRIES=5000

STORAGE_ENABLED=false
DATABASE_URL=sqlite+aiosqlite:///./codemate.db

MODEL_PROVIDER=mock
MODEL_BASE_URL=
MODEL_NAME=mock-model
MODEL_API_KEY=
MODEL_NOTE=
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2

# OpenAI-compatible examples:
# OpenAI/Codex-compatible provider:
# MODEL_PROVIDER=openai_compatible
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=<choose-current-openai-model>
# MODEL_API_KEY=<your-openai-api-key>
#
# DeepSeek:
# MODEL_PROVIDER=deepseek
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-chat
# MODEL_API_KEY=<your-deepseek-api-key>
#
# Anthropic Claude:
# MODEL_PROVIDER=anthropic
# MODEL_BASE_URL=https://api.anthropic.com/v1
# MODEL_NAME=claude-3-5-sonnet-latest
# MODEL_API_KEY=<your-anthropic-api-key>
#
# Alibaba Qwen OpenAI-compatible:
# MODEL_PROVIDER=qwen
# MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=qwen-plus
# MODEL_API_KEY=<your-dashscope-api-key>
#
# Zhipu GLM OpenAI-compatible:
# MODEL_PROVIDER=zhipu
# MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MODEL_NAME=glm-4
# MODEL_API_KEY=<your-zhipu-api-key>
#
# Moonshot Kimi OpenAI-compatible:
# MODEL_PROVIDER=moonshot
# MODEL_BASE_URL=https://api.moonshot.cn/v1
# MODEL_NAME=moonshot-v1-8k
# MODEL_API_KEY=<your-moonshot-api-key>

ENABLE_SENSITIVE_CONTENT_DETECTION=true
ENABLE_RATE_LIMIT=false
RATE_LIMIT_PER_MINUTE=60
